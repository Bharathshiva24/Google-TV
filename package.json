{
  "name": "google-tv",
  "version": "1.0.0",
  "description": "Google TV",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:dir": "electron-builder --mac --dir",
    "dist:sign": "python3 -m castlabs_evs.vmp sign-pkg \"$(find release -maxdepth 2 -name '*.app' -print -quit)\"",
    "dist:dmg": "electron-builder --mac dmg --prepackaged \"$(dirname \"$(find release -maxdepth 2 -name '*.app' -print -quit)\")\"",
    "dist": "npm run dist:dir && npm run dist:sign && npm run dist:dmg"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v39.8.10+wvcus",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bharathshiva.googletv",
    "productName": "Google TV",
    "files": [
      "main.js",
      "logos.js",
      "tmdb.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "identity": null
    },
    "dmg": {
      "title": "Google TV",
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bharathshiva24/Google-TV.git"
  },
  "author": "Bharath"
}
